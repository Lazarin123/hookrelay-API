# ============================================================================
#  HookRelay - configuração
#  Copie este arquivo:   cp .env.example .env
#  Depois edite o .env (ele NUNCA deve ser commitado; já está no .gitignore).
#  Só ADMIN_API_KEY é obrigatória. O resto tem padrões que funcionam.
# ============================================================================

# ---------------------------------------------------------------------------
# OBRIGATÓRIA: chave da API de administração
# ---------------------------------------------------------------------------
# Protege as rotas /endpoints, /events e /stats (enviada no cabeçalho x-api-key).
# Gere uma chave forte com:   openssl rand -hex 32
# Em produção (NODE_ENV=production) o app NÃO inicia com chave fraca (< 16 caracteres).
ADMIN_API_KEY=troque-esta-chave

# ---------------------------------------------------------------------------
# BANCO DE DADOS: a variável mais importante
# ---------------------------------------------------------------------------
# O HookRelay escolhe o banco pelo começo da URL:
#
#  A) SQLite (padrão): um arquivo local. Zero configuração, ótimo para desenvolver
#     e para rodar em uma VPS/servidor com disco persistente.
#     NÃO use em plataformas com disco efêmero (Render free, Heroku, Cloud Run...):
#     os dados somem a cada deploy/reinício.
DATABASE_URL="file:./data/hookrelay.db"
#
#  B) PostgreSQL (recomendado em produção): funciona com qualquer Postgres.
#     Veja docs/DATABASES.md para o passo a passo de onde criar um banco gratuito
#     (Neon, Supabase, Aiven, Railway...) e onde copiar a URL.
#     Formato:  postgresql://USUARIO:SENHA@HOST:5432/NOME_DO_BANCO?sslmode=verify-full
#     Exemplo:  postgresql://meu_user:minha_senha@ep-exemplo-123.us-east-2.aws.neon.tech/neondb?sslmode=verify-full
#     Se o provedor usa certificado próprio (erro "self-signed certificate"), troque o final por:
#               ?uselibpqcompat=true&sslmode=require
# DATABASE_URL="postgresql://usuario:senha@host:5432/banco?sslmode=verify-full"

# Máximo de conexões simultâneas (só Postgres). Planos gratuitos têm limites baixos.
# PG_POOL_MAX=5

# ---------------------------------------------------------------------------
# SERVIDOR
# ---------------------------------------------------------------------------
# NODE_ENV=production        # use "production" ao hospedar (o Dockerfile já define)
PORT=3000
HOST=0.0.0.0
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# URL pública da sua instância, usada para montar o campo "inboundUrl" nas respostas.
# Se vazio, é deduzida da requisição. Defina quando estiver atrás de proxy/domínio próprio.
# PUBLIC_URL=https://hookrelay.seudominio.com

# Ligue (true) se estiver atrás de proxy/load balancer (Render, Railway, Nginx, Cloudflare...)
# para registrar o IP real de quem enviou o webhook (em vez do IP do proxy).
TRUST_PROXY=false

# Tamanho máximo do corpo de um webhook recebido, em bytes (padrão: 1 MB).
MAX_BODY_BYTES=1048576

# Liga a documentação interativa em /docs e a especificação em /openapi.json
ENABLE_DOCS=true

# ---------------------------------------------------------------------------
# ENTREGA E RETRY
# ---------------------------------------------------------------------------
# Liga o processo que entrega/reenvia os webhooks. Deixe true (padrão).
# Só use false se for rodar várias instâncias e quiser separar a API do worker.
RUN_WORKER=true

# Total de tentativas por evento (a 1ª entrega conta). Ao esgotar, o evento vira "failed".
MAX_RETRIES=5

# Espera antes da 2ª tentativa; dobra a cada falha: 2s, 4s, 8s, 16s...
RETRY_BASE_DELAY_MS=2000
# Teto da espera entre tentativas (padrão: 1 hora).
RETRY_MAX_DELAY_MS=3600000

# Quanto esperar a resposta do seu servidor antes de considerar falha.
DELIVERY_TIMEOUT_MS=10000

# Frequência com que o worker procura eventos pendentes e quantos processa por vez.
WORKER_INTERVAL_MS=1000
WORKER_BATCH_SIZE=10

# ---------------------------------------------------------------------------
# SEGURANÇA E LIMPEZA
# ---------------------------------------------------------------------------
# Se true, recusa targetUrl apontando para localhost / IPs privados (10.x, 192.168.x, 127.x...).
# Ligue se outras pessoas puderem criar endpoints na sua instância.
# Limitação: confere só o que está escrito na URL, não resolve DNS (veja SECURITY.md).
BLOCK_PRIVATE_TARGETS=false

# Apaga automaticamente eventos (e tentativas) mais antigos que N dias. 0 = nunca apagar.
# Importante em planos gratuitos de banco, que têm limite de armazenamento.
EVENT_RETENTION_DAYS=30
